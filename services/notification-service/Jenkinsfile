pipeline {
    agent any

    environment {
        SERVICE_NAME = 'notification-service'
        IMAGE_NAME = 'student-task-pipeline-notification-service'
        DOCKER_HUB_USER = 'kp0705'
        KUBECONFIG = '/home/kartavya-patel/.kube/config'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    sh 'npm install'
                }
            }
        }

        stage('Test') {
            steps {
                dir("services/${SERVICE_NAME}") {
                    sh 'npm test -- --passWithNoTests'
                }
            }
        }

        stage('Docker Build into Minikube') {
            steps {
                sh '''
                    # Copy Minikube Docker TLS certs to workspace so jenkins user can read them
                    mkdir -p .minikube-certs
                    cp /home/kartavya-patel/.minikube/certs/ca.pem     .minikube-certs/ca.pem
                    cp /home/kartavya-patel/.minikube/certs/cert.pem   .minikube-certs/cert.pem
                    cp /home/kartavya-patel/.minikube/certs/key.pem    .minikube-certs/key.pem
                    chmod 600 .minikube-certs/*.pem
                '''
                dir("services/${SERVICE_NAME}") {
                    sh """
                        # Build directly into Minikube's Docker daemon
                        DOCKER_TLS_VERIFY=1 \
                        DOCKER_HOST=tcp://192.168.49.2:2376 \
                        DOCKER_CERT_PATH=\$(pwd)/../../.minikube-certs \
                        docker build -t ${IMAGE_NAME}:latest .
                    """
                }
            }
        }

        stage('Ansible Deploy') {
            steps {
                sh '''
                    # Flatten all certs inline so jenkins user doesn't hit permission denied on ~/.minikube
                    mkdir -p .kube
                    KUBECONFIG=/home/kartavya-patel/.kube/config kubectl config view --flatten > .kube/config
                    chmod 600 .kube/config
                    export KUBECONFIG=$(pwd)/.kube/config

                    kubectl config use-context minikube

                    # Override kubeconfig_path so Ansible uses workspace copy, not vault path
                    ansible-playbook ansible/playbooks/k8s-deploy.yml \
                        --vault-password-file .vault_pass \
                        -e "target_dir=k8s/${SERVICE_NAME}/" \
                        -e "service_name=${SERVICE_NAME}" \
                        -e "kubeconfig_path=$(pwd)/.kube/config"
                '''
            }
        }
    }

    post {
        success {
            emailext(
                to: "kpbhai0705@gmail.com",
                subject: "SUCCESS: ${currentBuild.fullDisplayName}",
                body: "The deployment was successful. Check logs at ${env.BUILD_URL}"
            )
            echo "${SERVICE_NAME} deployed successfully!"
        }
        failure {
            emailext(
                to: "kpbhai0705@gmail.com",
                subject: "FAILURE: ${currentBuild.fullDisplayName}",
                body: "The deployment failed. Check logs at ${env.BUILD_URL}"
            )
            echo "${SERVICE_NAME} deployment failed!"
        }
    }
}
